# =============================================================================
# Production Environment Variables for Skalkaho
# =============================================================================
# Copy this file to .env on your VPS:
#   scp .env.production.example user@vps:/opt/skalkaho/.env
#
# Then edit /opt/skalkaho/.env with production values
# =============================================================================

# Domain for Caddy (REQUIRED for HTTPS)
# Use your actual domain - Caddy will auto-provision Let's Encrypt certificate
DOMAIN=skalkaho.example.com

# Server Configuration
ADDR=:8080
ENVIRONMENT=production

# PostgreSQL (REQUIRED)
# Password used by both the postgres container and the app's connection string
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Session Secret (REQUIRED in production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# Docker Image Tag (set by CI/CD, can override manually)
# IMAGE_TAG=latest
